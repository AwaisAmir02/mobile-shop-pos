APP_NAME=HisabOKitab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production: APP_ENV=production and APP_DEBUG=false, always.
# Behind a CDN or proxy, its IPs/CIDRs (comma-separated), so rate limits see the real visitor.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Locally "log" writes emails to storage/logs. Live: MAIL_MAILER=resend + RESEND_API_KEY + a MAIL_FROM_ADDRESS
# on the domain verified in Resend. The full live list is .env.production.example.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# New support tickets are emailed here (empty turns it off).
SUPPORT_ALERT_EMAIL=info@hisabokitab.com
# New self-serve signups are emailed here (empty turns it off; missing falls back to SUPPORT_ALERT_EMAIL).
SIGNUP_ALERT_EMAIL=info@hisabokitab.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SITE_CONTACT_PHONE="+92 327 2754688"
SITE_CONTACT_WHATSAPP=923272754688
SITE_CONTACT_EMAIL=info@hisabokitab.com

BILLING_GATEWAY=manual_bank_transfer
# Fallback bank details for shops when no Payment Account is set up in Admin.
# Leave commented to see the built-in placeholder; "BILLING_BANK_INSTRUCTIONS=" would show nothing at all.
# BILLING_BANK_INSTRUCTIONS="Bank: ...\nAccount title: ...\nAccount number: ...\nIBAN: ..."
BRANDING_BILLING_PAYMENT_INSTRUCTIONS=
BRANDING_BILLING_SUPPORT_CONTACT=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=hok_login_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SENDER=
RESEND_API_KEY=

# Google Tag Manager on the public site (GA4 is set up inside the container). Not rendered while
# APP_ENV=local; blank turns it off everywhere.
GOOGLE_TAG_CONTAINER_ID=GTM-T9NJ569Q

BACKUP_ARCHIVE_PASSWORD=
BACKUP_ALERT_EMAIL=
BACKUP_HEARTBEAT_URL=
BACKUP_MYSQLDUMP_PATH=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── Online P2 store connections (docs/storefronts.md) ─────────────────────
# Shopify app (one app for every shop). Create it in the Shopify Partner Dashboard
# (partners.shopify.com > Apps > Create app, or the Dev Dashboard): copy the Client ID
# and Client secret from the app's settings. Set the app's redirect URL to
# https://YOUR-DOMAIN/storefronts/shopify/callback and its compliance (privacy)
# webhooks to https://YOUR-DOMAIN/webhooks/shopify. Scopes are requested by the app:
# read_products, read_inventory, write_inventory, read_orders, read_locations.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-10
# WooCommerce needs no keys here: each store owner approves our app on their own
# store, and WooCommerce sends that store's keys to /webhooks/woocommerce-keys.
# JazzCash per-order links (O7) use each shop's own JazzCash merchant account,
# entered under Settings > Customer payments; nothing to set here.
