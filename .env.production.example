# ─────────────────────────────────────────────────────────────────────────────
# HisabOKitab: complete .env for the LIVE server.
# Every variable the app (config/*.php, Laravel's own defaults, packages) reads.
# Copy to .env on the server, fill in the blanks, then: php artisan config:cache
#
#   [REQUIRED]  must be filled for the app or that feature to work
#   [OPTIONAL]  feature is off / safe default when blank
#   [UNUSED]    read by a stock config, but nothing in this app uses it: leave blank
#
# A line like "# VAR=" is deliberately commented out: in .env, "VAR=" means an
# empty string, which overrides the built-in default. Uncomment only to set a value.
# ─────────────────────────────────────────────────────────────────────────────

# ── App core ─────────────────────────────────────────────────────────────────
APP_NAME=HisabOKitab
APP_ENV=production
# [REQUIRED] generate with: php artisan key:generate --show
APP_KEY=
# [REQUIRED] false on live, always (AppServiceProvider also forces it off in production)
APP_DEBUG=false
# [REQUIRED] full https URL of the app; used in every email link and OAuth callback
APP_URL=https://YOUR-APP-DOMAIN
# [OPTIONAL] old APP_KEYs, comma-separated, only while rotating the key
APP_PREVIOUS_KEYS=
# [OPTIONAL] behind Cloudflare/a proxy: its IPs/CIDRs, comma-separated (or *), so rate limits see real visitors
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# [OPTIONAL] only used when APP_MAINTENANCE_DRIVER=cache
# APP_MAINTENANCE_STORE=

# ── Authentication [UNUSED: the defaults are right; listed for completeness] ──
# AUTH_GUARD=web
# AUTH_PASSWORD_BROKER=users
# AUTH_MODEL=App\Models\User
# AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
# Seconds before "confirm your password" asks again
# AUTH_PASSWORD_TIMEOUT=10800

# ── Password hashing (Laravel default config) ────────────────────────────────
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12
# [OPTIONAL]
# BCRYPT_LIMIT=
HASH_VERIFY=true
# [UNUSED] only for HASH_DRIVER=argon/argon2id
# ARGON_MEMORY=
# ARGON_THREADS=
# ARGON_TIME=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
# "daily" keeps LOG_DAILY_DAYS files instead of one ever-growing laravel.log
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false
# [UNUSED] Slack/Papertrail/syslog/stderr log channels aren't in the stack
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=
# LOG_SLACK_EMOJI=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_PAPERTRAIL_HANDLER=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_CONNECTION=mysql
# [REQUIRED]
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# [OPTIONAL] a full URL instead of the five above; or a unix socket
# DB_URL=
# DB_SOCKET=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# [OPTIONAL] only for a TLS connection to a remote MySQL
# MYSQL_ATTR_SSL_CA=
# [UNUSED] sqlite / postgres / sql server only
# DB_FOREIGN_KEYS=
# DB_SSLMODE=
# DB_ENCRYPT=
# DB_TRUST_SERVER_CERTIFICATE=

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on https (cookies never sent over plain http)
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_EXPIRE_ON_CLOSE=false
SESSION_TABLE=sessions
# [OPTIONAL] only for redis/memcached/dynamodb session drivers
# SESSION_CONNECTION=
# SESSION_STORE=

# ── Cache ────────────────────────────────────────────────────────────────────
CACHE_STORE=database
CACHE_PREFIX=
# DB_CACHE_CONNECTION=
DB_CACHE_TABLE=cache
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# [UNUSED] memcached / dynamodb caches
# MEMCACHED_HOST=
# MEMCACHED_PORT=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_PERSISTENT_ID=
# DYNAMODB_CACHE_TABLE=
# DYNAMODB_ENDPOINT=

# ── Queue (emails are queued; the scheduler's cron runs queue:work every minute) ──
QUEUE_CONNECTION=database
# DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
# [UNUSED] beanstalkd / sqs / redis queues
# BEANSTALKD_QUEUE_HOST=
# BEANSTALKD_QUEUE=
# BEANSTALKD_QUEUE_RETRY_AFTER=
# SQS_PREFIX=
# SQS_QUEUE=
# SQS_SUFFIX=
# REDIS_QUEUE_CONNECTION=
# REDIS_QUEUE=
# REDIS_QUEUE_RETRY_AFTER=

# ── Redis [UNUSED: nothing uses redis unless you switch cache/session/queue to it] ──
REDIS_CLIENT=phpredis
# REDIS_URL=
REDIS_HOST=127.0.0.1
# REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_PREFIX=
# REDIS_CLUSTER=
# REDIS_PERSISTENT=
# REDIS_MAX_RETRIES=
# REDIS_BACKOFF_ALGORITHM=
# REDIS_BACKOFF_BASE=
# REDIS_BACKOFF_CAP=
# REDIS_CACHE_CONNECTION=
# REDIS_CACHE_LOCK_CONNECTION=

# ── Broadcasting [UNUSED: no realtime broadcasting in this app] ───────────────
BROADCAST_CONNECTION=log
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=
# PUSHER_HOST=
# PUSHER_PORT=
# PUSHER_SCHEME=
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=
# REVERB_SCHEME=
# ABLY_KEY=
# [UNUSED]
# CONCURRENCY_DRIVER=

# ── Files ────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# [UNUSED] Amazon S3 / SES. Off-site backups use the R2_* block below instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Email: Resend ────────────────────────────────────────────────────────────
# [REQUIRED] "resend" sends real email. "log" only writes it to storage/logs (nothing delivered).
MAIL_MAILER=resend
# [REQUIRED] from resend.com → API Keys ("Sending access" is enough)
RESEND_API_KEY=
# [REQUIRED] an address on the domain you verified in Resend
MAIL_FROM_ADDRESS=no-reply@hisabokitab.com
# [UNUSED] the sender name is fixed to "HisabOKitab" in config/mail.php
MAIL_FROM_NAME="${APP_NAME}"
# [OPTIONAL] which log channel MAIL_MAILER=log writes to
# MAIL_LOG_CHANNEL=
# [UNUSED with Resend] only for MAIL_MAILER=smtp / sendmail
MAIL_SCHEME=null
# MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=
# [UNUSED] Postmark mailer
# POSTMARK_API_KEY=
# POSTMARK_MESSAGE_STREAM_ID=

# ── Who gets platform alert emails ───────────────────────────────────────────
# New support tickets (empty turns it off)
SUPPORT_ALERT_EMAIL=info@hisabokitab.com
# New self-serve signups (empty turns it off; if the line is missing, SUPPORT_ALERT_EMAIL is used)
SIGNUP_ALERT_EMAIL=info@hisabokitab.com

# ── Backups ──────────────────────────────────────────────────────────────────
# [REQUIRED] encrypts the backup zip; keep a copy somewhere safe or backups can't be opened
BACKUP_ARCHIVE_PASSWORD=
# [OPTIONAL] email when a backup fails or hasn't run for 26h
BACKUP_ALERT_EMAIL=info@hisabokitab.com
# [OPTIONAL] URL pinged after each good backup (e.g. a free healthchecks.io / UptimeRobot heartbeat)
BACKUP_HEARTBEAT_URL=
# [OPTIONAL] auto = mysqldump if found, else PHP
BACKUP_DUMPER=auto
BACKUP_MYSQLDUMP_PATH=
BACKUP_REMOTE_DISK=r2
# [REQUIRED for off-site backups] Cloudflare R2 bucket + API token (blank = backups stay on this server only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com

# ── Login codes by phone ─────────────────────────────────────────────────────
# [OPTIONAL] WhatsApp codes for phone signup / password reset (Meta WhatsApp Cloud API, approved template)
WHATSAPP_OTP_PHONE_NUMBER_ID=
WHATSAPP_OTP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE=hok_login_code
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
# [OPTIONAL] SMS fallback for the same codes (Plivo, Pakistani mobiles)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SENDER=

# ── Signup bot check ─────────────────────────────────────────────────────────
# [REQUIRED for bot protection] Cloudflare Turnstile; blank = the check is SKIPPED and every signup passes
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Social login ─────────────────────────────────────────────────────────────
# [OPTIONAL] blank hides the button. Redirect URIs default to /auth/{google,microsoft}/callback on APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# ── Meta (WhatsApp/Facebook/Ads for shops) ───────────────────────────────────
# The Meta app ID/secret are NOT here: enter them in Admin → Integrations (stored in the database).
META_GRAPH_VERSION=v25.0
META_ALLOW_MANUAL_CONNECT=false
# Highest daily ad budget (Rs) a shop can set
META_ADS_MAX_DAILY_BUDGET=50000

# ── Billing ──────────────────────────────────────────────────────────────────
BILLING_GATEWAY=manual_bank_transfer
# [REQUIRED unless you add Payment Accounts in Admin] fallback bank details shown to shops.
# If this line is missing, shops see "PLACEHOLDER BANK DETAILS — replace before launch".
BILLING_BANK_INSTRUCTIONS="Bank: \nAccount title: \nAccount number: \nIBAN: "
# [OPTIONAL] extra text on billing screens / invoices
BRANDING_BILLING_PAYMENT_INSTRUCTIONS=
BRANDING_BILLING_SUPPORT_CONTACT=

# ── Site contact details ─────────────────────────────────────────────────────
SITE_CONTACT_PHONE="+92 327 2754688"
SITE_CONTACT_WHATSAPP=923272754688
SITE_CONTACT_EMAIL=info@hisabokitab.com

# ── Not used by this app ─────────────────────────────────────────────────────
# [UNUSED] Slack notification channel (stock services.php entry, nothing sends to it)
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=
# [UNUSED] nothing in resources/js reads it
VITE_APP_NAME="${APP_NAME}"
# [UNUSED on live] local tools only: php artisan serve / tinker
# PHP_CLI_SERVER_WORKERS=
# TINKER_TRUST_PROJECT=
